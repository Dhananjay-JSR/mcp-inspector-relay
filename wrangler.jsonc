{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-inspector-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://vscode.dev,https://insiders.vscode.dev,https://github.dev,https://insiders.github.dev,http://localhost:3000,http://127.0.0.1:3000"
  }
}
