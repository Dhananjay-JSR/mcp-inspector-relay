{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-inspector-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mcp-relay.dhananjaay.dev",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://vscode.dev,https://insiders.vscode.dev,https://github.dev,https://insiders.github.dev,http://localhost:3000,http://127.0.0.1:3000",
    "ALLOW_LOCAL_ORIGINS": "true"
  }
}
